{
	"name": "zotero-bookgroup",
	"type": "module",
	"version": "1.0.1",
	"description": "Groups book sections and encyclopedia articles visually under their edited volume, based on Zotero's related-item relations.",
	"config": {
		"addonName": "Book Group",
		"addonID": "bookgroup@justanotherjurastudent.github.io",
		"addonRef": "bookgroup",
		"addonInstance": "BookGroup",
		"prefsPrefix": "extensions.zotero.bookgroup"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/justanotherjurastudent/zotero_SortPartsToBooks.git"
	},
	"author": "justanotherjurastudent",
	"bugs": {
		"url": "https://github.com/justanotherjurastudent/zotero_SortPartsToBooks/issues"
	},
	"homepage": "https://github.com/justanotherjurastudent/zotero_SortPartsToBooks#readme",
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"start": "zotero-plugin serve",
		"build": "zotero-plugin build && tsc --noEmit",
		"lint:check": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude . && eslint .",
		"lint:fix": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude . && eslint . --fix",
		"release": "zotero-plugin release",
		"test": "zotero-plugin test",
		"test:unit": "node --test \"test/unit/*.test.ts\"",
		"update-deps": "npm update --save"
	},
	"dependencies": {
		"zotero-plugin-toolkit": "^5.2.0"
	},
	"devDependencies": {
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.10.0",
		"@zotero-plugin/eslint-config": "^0.6.10",
		"chai": "^6.2.2",
		"eslint": "^10.10.0",
		"mocha": "^12.0.1",
		"prettier": "^3.9.6",
		"typescript": "~6.0.3",
		"zotero-plugin-scaffold": "^0.9.2",
		"zotero-types": "^4.1.3"
	},
	"prettier": {
		"printWidth": 100,
		"useTabs": true,
		"tabWidth": 4,
		"endOfLine": "lf",
		"overrides": [
			{
				"files": [
					"*.xhtml"
				],
				"options": {
					"htmlWhitespaceSensitivity": "css"
				}
			}
		]
	}
}
